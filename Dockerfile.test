# syntax=docker/dockerfile:1
FROM python:3-slim AS test

LABEL maintainer="Netresearch DTT GmbH <sebastian.mendel@netresearch.de>" \
      org.opencontainers.image.title="jira-to-openproject-test" \
      org.opencontainers.image.description="Test image for jira-to-openproject" \
      org.opencontainers.image.source="https://github.com/netresearch/jira-to-openproject" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# System deps (build tools kept here since tests may compile extensions)
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
        libffi-dev \
        libssl-dev \
        openssh-client \
        python3-dev \
        tmux \
    && rm -rf /var/lib/apt/lists/*
# docker.io intentionally omitted - uses SSH-based remote Docker client

# Upstream publishes a rolling binary image and has no major-only uv:0 tag.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app

# Dependency layer (cached): locked dependencies incl. the dev and test
# extras, installed into the system interpreter. compose.yml bind-mounts the
# source tree over /app at test time, so an /app/.venv would be hidden.
# --inexact keeps the base image's own packages (pip) in place.
COPY pyproject.toml uv.lock ./
COPY scripts/locked_pyyaml_requirement.py /tmp/
# PyYAML has no CPython 3.15 Linux wheel. Only this hash-locked dependency
# may build from source. Install every other third-party package wheel-only.
RUN --mount=type=cache,target=/root/.cache/uv \
    python /tmp/locked_pyyaml_requirement.py > /tmp/j2o-pyyaml.txt \
    && uv pip install --python /usr/local/bin/python --require-hashes --no-deps -r /tmp/j2o-pyyaml.txt

RUN UV_PROJECT_ENVIRONMENT=/usr/local \
    uv sync --frozen --inexact --no-build --no-install-package pyyaml --no-dev --extra dev --extra test --no-install-project

# Keep test fixtures, package sources and tooling in their repository layout.
COPY --parents --chown=appuser:appuser \
    src config jira scripts tests tools api-specs test-specs contrib docs examples \
    .github/workflows .coveragerc .importlinter .env.example \
    AGENTS.md README.md LICENSE Makefile compose.yml Dockerfile Dockerfile.test ./

# Install the locked project and prepare writable runtime directories.
RUN uv build --wheel --out-dir /tmp/j2o-dist . \
    && uv pip install --system --no-build --no-deps /tmp/j2o-dist/*.whl \
    && rm -rf /tmp/j2o-dist \
    && mkdir -p /app/var/logs /app/var/data /app/var/run \
    && chown -R appuser:appuser /app/var

USER appuser

# Test image is also long-running (`sleep infinity`) — the healthcheck
# verifies pytest can collect from the test suite. A 0-test result still
# counts as healthy; a collection error or missing pytest does not.
HEALTHCHECK --interval=30s --timeout=15s --start-period=20s --retries=3 \
    CMD pytest --collect-only -q tests/unit > /dev/null 2>&1 || exit 1

CMD ["sleep", "infinity"]
